{
  "name": "@comprehensiveio/compadre",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/start.js",
    "workflow:relay-probe": "tsx scripts/probe-workflow-relay.ts",
    "slack:simulate": "tsx scripts/simulate-slack.ts",
    "benchmark:cold-start": "tsx scripts/benchmark-cold-start.ts",
    "modal:prepare-image": "tsx scripts/prepare-modal-image.ts",
    "experiment:t3-modal": "tsx scripts/launch-t3-modal.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "test:thread-persistence": "tsx --test src/persistence/conversation.test.ts src/persistence/conversation.integration.test.ts",
    "test:persistence": "vitest run src/persistence/postgres.conformance.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.222",
    "@aws-sdk/client-s3": "^3.1103.0",
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex": "0.146.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@tanstack/ai": "0.44.0",
    "@tanstack/ai-claude-code": "0.3.1",
    "@tanstack/ai-codex": "0.3.1",
    "@tanstack/ai-mcp": "0.3.0",
    "@tanstack/ai-persistence": "0.1.2",
    "@tanstack/ai-react": "^0.19.2",
    "@tanstack/ai-sandbox": "0.3.1",
    "@tanstack/ai-sandbox-local-process": "0.2.1",
    "dd-trace": "^5.119.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "4.13.0",
    "modal": "^0.9.0",
    "pg": "8.23.0",
    "pg-cursor": "2.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.3.6",
    "@types/node": "^22.20.1",
    "@types/pg": "8.21.0",
    "@types/pg-cursor": "2.7.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "4.1.10"
  }
}
