# Claude API
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-opus-5
FABLE_MODEL=claude-fable-5
DEFAULT_MAX_TURNS=50
# Optional override; otherwise the project-local Claude Code CLI is used
CLAUDE_CODE_EXECUTABLE=

# Codex harness
# Codex API key; alternatively authenticate the project-local Codex CLI.
CODEX_API_KEY=
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=high
# Optional override; otherwise the project-local @openai/codex CLI is used
CODEX_EXECUTABLE=

# Datadog tracing
DD_SERVICE=compadre
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=compadre
# Enables dd-trace as the OpenTelemetry provider for TanStack AI spans.
DD_TRACE_OTEL_ENABLED=true
# Routes OpenTelemetry traces and metrics from TanStack AI through dd-trace.
DD_METRICS_OTEL_ENABLED=true

# MCP Auth Tokens
# Use a Datadog Service Access Token (SAT) for deployed services.
DATADOG_MCP_ACCESS_TOKEN=
# Optional: override for a non-US1 Datadog site or a different toolset selection.
# DATADOG_MCP_URL=https://mcp.datadoghq.eu/v1/mcp?toolsets=core,apm,llmobs
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
LINEAR_MCP_ACCESS_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
RENDER_API_KEY=

# Google Workspace MCP (optional - enables Google Workspace bot access)
GOOGLE_WORKSPACE_USER_EMAIL=compadre@yourdomain.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# AWS S3 (optional - enables S3 read access)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# Database
READONLY_DATABASE_URL=postgresql://...

# Git
GITHUB_REPO_URL=https://github.com/comprehensiveio/comp.git
REPO_PATH=/opt/render/repo
# Number of fully prepared, unclaimed worktrees kept ready (0-2; default 1).
COMPADRE_PREPARED_WORKTREES=1

# Auth
COMPADRE_API_KEY=

# Optional provider-neutral AG-UI endpoint (default off)
COMPADRE_TANSTACK_AI_ENABLED=false
# Default harness for requests without forwardedProps.provider
COMPADRE_AGENT_PROVIDER=claude-code
# Hard wall-clock safety limit for an agent run (15 minutes)
COMPADRE_AGENT_MAX_DURATION_MS=900000
# Combined RSS limit for the agent process tree. Exceeding it aborts the run.
COMPADRE_AGENT_TREE_MEMORY_MB=2560
# Preserve this much cgroup memory for Compadre to report and clean up a failure.
COMPADRE_CGROUP_MEMORY_HEADROOM_MB=768

# Server
PORT=3100
