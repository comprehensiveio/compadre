# Claude API
ANTHROPIC_API_KEY=
FABLE_MODEL=claude-fable-5

# Datadog tracing
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=compadre

# MCP Auth Tokens (obtained via OAuth flows or API keys)
DATADOG_MCP_CLIENT_ID=
DATADOG_MCP_REFRESH_TOKEN=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
LINEAR_MCP_ACCESS_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
RENDER_API_KEY=

# Google Workspace MCP (optional - enables Google Workspace bot access)
GOOGLE_WORKSPACE_USER_EMAIL=compadre@yourdomain.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# AWS S3 (optional - enables S3 read access)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# Database
DATABASE_URL=postgresql://...

# Git
GITHUB_REPO_URL=https://github.com/comprehensiveio/comp.git
REPO_PATH=/opt/render/repo

# Auth
COMPADRE_API_KEY=

# Server
PORT=3100
