# Claude API
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-opus-5
FABLE_MODEL=claude-fable-5
# Optional override; otherwise the project-local Claude Code CLI is used
CLAUDE_CODE_EXECUTABLE=

# Codex harness
# Codex API key; alternatively authenticate the project-local Codex CLI.
CODEX_API_KEY=
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=high
# Optional override; otherwise the project-local @openai/codex CLI is used
CODEX_EXECUTABLE=

# Datadog tracing
DD_SERVICE=compadre
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=compadre
# Enables dd-trace as the OpenTelemetry provider for TanStack AI spans.
DD_TRACE_OTEL_ENABLED=true
# Routes OpenTelemetry traces and metrics from TanStack AI through dd-trace.
DD_METRICS_OTEL_ENABLED=true
# Optional override for agentless Workflow trace export. By default this is
# derived as https://otlp.${DD_SITE:-datadoghq.com}/v1/traces.
DD_OTLP_TRACES_ENDPOINT=
# Set to agentless on a managed service that cannot reach a Datadog Agent.
COMPADRE_OTEL_EXPORT_MODE=
# Native T3 workers inherit these settings. The traces URL is derived from
# DD_SITE when DD_API_KEY is present unless explicitly overridden.
T3CODE_OTLP_TRACES_URL=
T3CODE_OTLP_SERVICE_NAME=compadre-t3-worker

# TanStack run lifecycle and AG-UI delivery durability. Leave unset/off for the
# normal database-free local server; use memory for local Workflow replay tests.
COMPADRE_DURABILITY_BACKEND=off
COMPADRE_DURABILITY_DATABASE_URL=

# MCP Auth Tokens
# Use a Datadog Service Access Token (SAT) for deployed services.
DATADOG_MCP_ACCESS_TOKEN=
# Optional: override for a non-US1 Datadog site or a different toolset selection.
# DATADOG_MCP_URL=https://mcp.datadoghq.eu/v1/mcp?toolsets=core,apm,llmobs
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_SIGNING_SECRET=
# Optional. Slack event callbacks normally include this installation's bot ID;
# set it explicitly when using synthetic callbacks that omit authorizations.
SLACK_BOT_USER_ID=
COMPADRE_SLACK_APP_ID=
LINEAR_MCP_ACCESS_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
RENDER_API_KEY=

# Google Workspace MCP (optional - enables Google Workspace bot access)
GOOGLE_WORKSPACE_USER_EMAIL=compadre@yourdomain.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# AWS S3 (optional). The hosted T3 artifact bucket stores generated file bytes;
# Postgres stores only their content-addressed metadata. Prefer workload
# identity when available; otherwise use a dedicated least-privilege key stored
# as managed deployment secrets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
COMPADRE_T3_ARTIFACT_BUCKET=
# Optional override when the artifact bucket is not in AWS_REGION.
COMPADRE_T3_ARTIFACT_REGION=

# Database
READONLY_DATABASE_URL=postgresql://...

# Git
GITHUB_REPO_URL=https://github.com/comprehensiveio/comp.git
# Optional local checkout for development and the PR deployment watcher.
REPO_PATH=/path/to/local/comp

# Legacy workflow-run compatibility route. Execution still goes through the
# central hosted T3 service; this flag no longer selects a Workflow harness.
COMPADRE_WORKFLOW_RELAY_ENABLED=false
COMPADRE_PROCESS_ROLE=relay

# Auth
COMPADRE_API_KEY=
# Optional separate credential for the Comp app MCP and debug-link API. This
# falls back to COMPADRE_API_KEY for the primary deployment.
COMP_APP_URL=
COMP_APP_API_KEY=

# Optional AG-UI compatibility endpoint (default off). TanStack is used only
# to decode/encode the protocol; central hosted T3 owns execution and history.
COMPADRE_TANSTACK_AI_ENABLED=false
# Native T3 controller: Render owns global thread routing metadata and
# each provider-bound thread owns one isolated Modal sandbox running T3.
COMPADRE_T3_DIRECTORY_ENABLED=false
# Central T3 is the durable conversation owner for Slack and browser entry.
# Issue a scoped bearer with `t3 auth session issue`; do not reuse the
# Compadre controller API key as a T3 access token.
COMPADRE_T3_CENTRAL_URL=
COMPADRE_T3_CENTRAL_TOKEN=
COMPADRE_BACKUP_TOKEN=
# Optional when the central environment owns more than one project. By
# default Slack threads use the first active T3 project.
COMPADRE_T3_CENTRAL_PROJECT_ID=
# Modal application used for isolated native T3 workers.
COMPADRE_T3_MODAL_APP=compadre-t3-experiment

# Lazy per-thread Comp development servers. Enabling this adds the stopped
# Postgres/Redis/Chromium toolchain and an encrypted port 3000 tunnel to newly
# created thread sandboxes; services start only when the agent invokes the
# dev-environment skill.
COMPADRE_DEV_ENVIRONMENT_ENABLED=false
COMPADRE_DEV_ARTIFACT_BUCKET=compadre
COMPADRE_DEV_ARTIFACT_PREFIX=dev-environments/comp
COMPADRE_DEV_ARTIFACT_REGION=us-west-2
COMPADRE_DEV_ARTIFACT_URL_TTL_SECONDS=604800
# Authenticated browser gateway for per-thread dev previews. The secret is
# shared only by the controller and central T3 service; it is never projected
# into Modal or the browser.
COMPADRE_PREVIEW_HOST_SUFFIX=dev.compadre.comprehensive.io
COMPADRE_PREVIEW_GATEWAY_SECRET=
# Optional local T3 fork archive overlay. This path must exist on the relay
# host, so deployed environments should package/fetch the fork reproducibly.
COMPADRE_T3_PACKAGE_PATH=
# Optional dedicated bearer credential for the shared native-T3 MCP bridge.
COMPADRE_T3_MCP_BEARER_TOKEN=
# Set false for synthetic hosted probes that should retain Slack MCP access but
# must not mirror browser-started turns into linked Slack threads.
COMPADRE_HOSTED_SLACK_DELIVERY_ENABLED=true
# Default harness for requests without forwardedProps.provider
COMPADRE_AGENT_PROVIDER=claude-code

# Modal harness execution. The relay, Postgres, MCP clients, and
# private-network tools remain on Render; only the coding harness runs here.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Optional Modal environment and sandbox tuning.
MODAL_ENVIRONMENT=
COMPADRE_MODAL_APP=compadre
COMPADRE_MODAL_BASE_IMAGE=node:22
COMPADRE_MODAL_WORKDIR=/workspace
COMPADRE_MODAL_CLI_ROOT=/opt/compadre-runtime
COMPADRE_MODAL_TIMEOUT_MS=7200000
COMPADRE_MODAL_SNAPSHOT_TTL_MS=604800000
COMPADRE_MODAL_CPU=0.5
COMPADRE_MODAL_CPU_LIMIT=2
COMPADRE_MODAL_MEMORY_MIB=2048
COMPADRE_MODAL_MEMORY_LIMIT_MIB=8192
# Set only when a custom base image already contains `claude` and `codex` on PATH.
COMPADRE_MODAL_SKIP_CLI_SETUP=false
# Public HTTPS origin of the relay. Modal uses this for the authenticated,
# run-scoped TanStack host-tool bridge.
COMPADRE_PUBLIC_URL=

# Server
PORT=3100
